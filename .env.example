# Postgres diretto (Prisma / server)
# Il pool viene limitato in src/lib/db.ts (connection_limit=1 su Vercel, 3 in locale).
# Opzionale: PRISMA_CONNECTION_LIMIT=2  PRISMA_POOL_TIMEOUT=10
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5433/analisi_siti"
DB_HOST=
DB_PORT=5433
DB_NAME=analisi_siti
DB_USER=
DB_PASSWORD=
PRISMA_CONNECTION_LIMIT=


# PostgREST
NEXT_PUBLIC_REST_URL=https://postgres.firewallsrl.com/rest/v1/analisi_siti
NEXT_PUBLIC_ANON_KEY=

# solo server — non esporre al browser
SERVICE_ROLE_KEY=

CREDENTIALS_SECRET="replace-with-openssl-rand-hex-32"

# Auth (login operatore)
AUTH_SECRET="replace-with-openssl-rand-hex-32"
AUTH_ADMIN_EMAIL="admin@example.com"
AUTH_ADMIN_PASSWORD="change-me"
AUTH_ADMIN_NAME="Admin"

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# false = remediation reale; scan live se ci sono credenziali
DEMO_SCAN="false"

# Email report (SMTP) — obbligatorio per "Invia report"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SiteGuard <noreply@example.com>"
# Destinatario precompilato nel form (opzionale)
REPORT_DEFAULT_TO=""
